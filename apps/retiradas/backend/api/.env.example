PGHOST=127.0.0.1
PGPORT=5432
PGUSER=retorninho
PGDATABASE=retiradas
PGPASSWORD=SENHA
PORT=3001
CORS_ORIGIN=https://retiradas.tech
NODE_ENV=production
ACCESS_TOKEN_TTL_SECONDS=31536000
ACCESS_TOKEN_RENEW_WINDOW_SECONDS=604800
APP_AUTH_ISSUER=retiradas-api
APP_AUTH_AUDIENCE=retiradas-web
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
REALTIME_RATE_LIMIT_WINDOW_MS=60000
REALTIME_RATE_LIMIT_MAX=30
PUBLIC_WRITE_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_WRITE_RATE_LIMIT_MAX=20
PUBLIC_VISIT_MAX_BYTES=4096
JSON_BODY_LIMIT=10mb
DB_BACKUP_AGE_RECIPIENT=
DB_BACKUP_AGE_IDENTITY_FILE=/etc/retiradas/backup-age-key.txt
# Necessario para PUT /api/documents/* e PUT /api/static/:domain.
INTERNAL_API_TOKEN=
# Necessario para assinar e validar as sessoes locais da VPS.
APP_AUTH_SECRET_ID=current
APP_AUTH_SECRET=troque-por-um-segredo-com-mais-de-24-caracteres
# Formato para rotacao sem downtime: antigo1:segredo-antigo-mais-de-24-caracteres,antigo2:outro-segredo
APP_AUTH_PREVIOUS_SECRETS=
# Integracao de consulta de equipamentos na API Sempre/Playground.
# O token Bearer deve ser cadastrado na tela Integracoes, registro "API Sempre Playground".
SEMPRE_API_BASE_URL=https://playground.sempre.net.br/api
SEMPRE_API_SISTEMA_ID=6
SEMPRE_API_TIMEOUT_MS=15000

# Segredos obrigatorios em producao para aceitar callbacks externos.
# Use valores longos e aleatorios. Envie o valor no header x-retiradas-webhook-secret
# ou no parametro ?secret= quando a ferramenta externa nao permitir header.
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_OFFICIAL_VERIFY_TOKEN=
WHATSAPP_OFFICIAL_WEBHOOK_SECRET=

# Google Drive API via Service Account.
# Compartilhe a pasta raiz do Drive com o e-mail client_email do JSON da Service Account.
GOOGLE_APPLICATION_CREDENTIALS=/etc/retiradas/google-drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
DOCUMENTOS_UPLOAD_LIMIT_BYTES=26214400

# Alternativa para pasta normal do Meu Drive: OAuth com uma conta Google real.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://retiradas.tech/api/documentos/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
DOCUMENTOS_UPLOAD_MAX_FILES=30
