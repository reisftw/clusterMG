ROT_API_PORT=3201
# Dominio canonico do sistema Operacao. rot.retiradas.tech (nome antigo)
# continua ativo como alias ate a migracao de DNS/certificado ser feita
# na VPS — nao remover suporte a ele so por causa desta troca de default.
ROT_PUBLIC_URL=https://operacao.retiradas.tech
# Allowlist de origens do CORS, separadas por virgula. Obrigatorio em
# producao — sem isso o CORS so libera as origens de desenvolvimento local
# (ver DEFAULT_DEV_ORIGINS em backend/src/security/cors.js) + ROT_PUBLIC_URL.
ROT_CORS_ORIGINS=https://operacao.retiradas.tech,https://rot.retiradas.tech
ROT_DATABASE_URL=
# Origem opcional para sincronizar cadastros legados do Retiradas.
# Quando vazio, a sincronizacao tenta ler app_documents no proprio banco da Operacao.
RETIRADAS_DATABASE_URL=
RETIRADAS_PGHOST=
RETIRADAS_PGPORT=5432
RETIRADAS_PGUSER=
RETIRADAS_PGPASSWORD=
RETIRADAS_PGDATABASE=
RETIRADAS_PGSSLMODE=
# Limites do pool de conexoes (pg).
ROT_PG_POOL_MAX=10
ROT_PG_IDLE_TIMEOUT_MS=30000
ROT_PG_CONNECTION_TIMEOUT_MS=5000
ROT_SLOW_QUERY_MS=500
# JWT — segredo forte e unico, nunca reaproveitar o de outro app do
# ecossistema. Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ROT_JWT_SECRET=
ROT_JWT_TTL=12h
ROT_PASSWORD_RESET_TTL_MINUTES=30
ROT_LOGIN_RATE_LIMIT=20
ROT_PASSWORD_RESET_RATE_LIMIT=10
ROT_RATE_LIMIT_PER_MINUTE=600
# OAuth Google — mesmo Client ID/fluxo ja usado no app principal
# (vps/api/src/auth.js). Deixe vazio pra desabilitar login com Google.
ROT_GOOGLE_OAUTH_CLIENT_ID=
ROT_GOOGLE_OAUTH_ALLOWED_DOMAINS=
# Gemini (assistente Warlinho) — mantido da Operação original, so atualizando
# do modelo legado gemini-pro pro Gemini atual.
ROT_GEMINI_API_KEY=

# Object Storage de imagens — provider atual Cloudflare R2 via API S3.
# Nunca coloque chaves no frontend nem em VITE_*.
STORAGE_DEFAULT_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=rot-site
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Preparado para uso futuro com S3/MinIO/Wasabi/etc.
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_FORCE_PATH_STYLE=false

# E-mail (SMTP) — cadastro/troca-de-senha/reset e MFA de login. Mesmo
# padrao do Finan (apps/finan/.env.example); pode reaproveitar a mesma
# conta Hostinger ja usada la, ou uma dedicada.
ROT_SMTP_HOST=smtp.hostinger.com
ROT_SMTP_PORT=465
ROT_SMTP_SECURE=true
ROT_SMTP_USER=
ROT_SMTP_PASSWORD=
ROT_EMAIL_FROM=naoresponda@retiradas.tech
ROT_EMAIL_FROM_NAME=OPERAÇÃO | Cluster MG
ROT_EMAIL_REPLY_TO=
# MFA por e-mail no login — habilitado por padrao (mesma decisao do Finan:
# nao e opt-in por usuario, e o padrao pra todo mundo).
ROT_MFA_EMAIL_ENABLED=true
ROT_MFA_EMAIL_TTL_MINUTES=10
ROT_MFA_MAX_ATTEMPTS=5
