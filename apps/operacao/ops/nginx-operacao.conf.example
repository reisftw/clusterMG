server {
	# Dominio canonico: operacao.retiradas.tech. rot.retiradas.tech (nome
	# antigo) continua ativo como alias nesta VPS — nao mexer no
	# certificado/DNS dele so por causa desta troca de exemplo. Quando a
	# equipe decidir aposentar o alias de vez, o bloco HTTP abaixo passa a
	# fazer 301 pra operacao.retiradas.tech em vez de redirecionar pra si
	# mesmo (ver comentario no segundo server{} deste arquivo).
	server_name operacao.retiradas.tech rot.retiradas.tech;

	add_header Strict-Transport-Security "max-age=31536000" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;
	add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
	# script-src/style-src-elem/frame-src liberam accounts.google.com: o
	# "Entrar com Google" (Google Identity Services) carrega um script
	# externo, injeta CSS proprio e renderiza o botao num iframe — sem essas
	# excecoes o CSP bloqueia o script inteiro (bug real visto em producao:
	# botao nunca aparecia, so o divisor "ou").
	add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self'; style-src-elem 'self' 'unsafe-inline' https://accounts.google.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; object-src 'none'; frame-ancestors 'self'; frame-src https://accounts.google.com; base-uri 'self'; form-action 'self';" always;

	client_max_body_size 200M;
	root /opt/retiradas/apps/rot/frontend/dist;
	index index.html;

	location /api/ {
		proxy_pass http://127.0.0.1:3201/api/;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
	}

	# Assets do build (Vite) tem hash no nome — cache "para sempre" e seguro.
	location /assets/ {
		add_header Strict-Transport-Security "max-age=31536000" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
		add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self'; style-src-elem 'self' 'unsafe-inline' https://accounts.google.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; object-src 'none'; frame-ancestors 'self'; frame-src https://accounts.google.com; base-uri 'self'; form-action 'self';" always;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		try_files $uri =404;
	}

	# index.html NUNCA pode ser cacheado — mesma licao aprendida com
	# finan.retiradas.tech (sem isso, deploy novo fica preso atras de
	# index.html antigo apontando pra assets antigos).
	location / {
		add_header Strict-Transport-Security "max-age=31536000" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
		add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self'; style-src-elem 'self' 'unsafe-inline' https://accounts.google.com; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; object-src 'none'; frame-ancestors 'self'; frame-src https://accounts.google.com; base-uri 'self'; form-action 'self';" always;
		add_header Cache-Control "no-cache, no-store, must-revalidate" always;
		try_files $uri $uri/ /index.html;
	}
}

server {
	listen 80;
	server_name operacao.retiradas.tech rot.retiradas.tech;

	return 301 https://operacao.retiradas.tech$request_uri;
}

# Proposta futura (NAO aplicar nesta etapa): quando operacao.retiradas.tech
# estiver validado em producao e a equipe decidir aposentar o alias, trocar
# o server_name do bloco HTTPS acima pra so `operacao.retiradas.tech` e
# adicionar um bloco dedicado assim, fazendo rot.retiradas.tech redirecionar
# (301) pro dominio canonico em vez de servir o mesmo conteudo:
#
