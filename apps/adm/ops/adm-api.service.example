[Unit]
Description=Administrativo API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/retiradas/apps/adm/backend
EnvironmentFile=/opt/retiradas/apps/adm/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
User=svc-adm
Group=svc-adm
; EnvironmentFile e lido pelo systemd (PID 1, root) antes de trocar de
; usuario, entao continua funcionando mesmo com o .env em modo 600
; dono root — nao precisa liberar leitura do .env pro svc-adm.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
PrivateDevices=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/retiradas/apps/adm/backend/uploads /opt/retiradas/backups/adm-postgres /tmp

[Install]
WantedBy=multi-user.target
