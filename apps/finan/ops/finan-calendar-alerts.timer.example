[Unit]
Description=Agenda diaria dos alertas do Calendario Financeiro

[Timer]
; 10:00 UTC = ~07:00 em America/Sao_Paulo (UTC-3, sem horario de verao) —
; roda de manha cedo, antes do horario comercial, pra avisar sobre
; vencimentos/rotinas do(s) proximo(s) dia(s) configurado(s) por evento.
; Ajuste se o fuso do servidor for outro (confirme com `timedatectl`).
OnCalendar=*-*-* 10:00:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
