[Unit]
Description=Finan Calendario Financeiro - alertas por e-mail
After=postgresql.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/retiradas/apps/finan/backend
EnvironmentFile=/opt/retiradas/apps/finan/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run calendario:enviar-alertas
; Mesmo usuario/politica do finan-db-backup.service — o .env (permissao
; 600, dono root) so e legivel por root.
User=root
NoNewPrivileges=true
PrivateTmp=true
