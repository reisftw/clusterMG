[Unit]
Description=Finan API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/retiradas/apps/finan/backend
EnvironmentFile=/opt/retiradas/apps/finan/.env
ExecStart=/usr/bin/npm run api:start
Restart=always
RestartSec=5
User=svc-finan
Group=svc-finan
; EnvironmentFile e lido pelo systemd (PID 1, root) antes de trocar de
; usuario, entao continua funcionando mesmo com o .env em modo 600
; dono root — nao precisa liberar leitura do .env pro svc-finan.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
PrivateDevices=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/retiradas/backups/finan /tmp

[Install]
WantedBy=multi-user.target
