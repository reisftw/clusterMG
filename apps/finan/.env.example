FINAN_API_PORT=3101
FINAN_PUBLIC_URL=https://finan.retiradas.tech
# Allowlist de origens do CORS, separadas por virgula. Obrigatorio em
# producao — sem isso o CORS so libera as origens de desenvolvimento local
# (ver DEFAULT_DEV_ORIGINS em src/security/cors.js) + FINAN_PUBLIC_URL.
FINAN_CORS_ORIGINS=https://finan.retiradas.tech
FINAN_DATABASE_URL=
# Limites do pool de conexoes (pg). Ajuste FINAN_PG_POOL_MAX considerando
# max_connections do Postgres dividido pelo numero de instancias do Finan
# rodando ao mesmo tempo (hoje: processo unico via systemd).
FINAN_PG_POOL_MAX=10
FINAN_PG_IDLE_TIMEOUT_MS=30000
FINAN_PG_CONNECTION_TIMEOUT_MS=5000
# Loga um aviso (sem parametros da query) quando uma query do Finan demorar
# mais que isto.
FINAN_SLOW_QUERY_MS=500
FINAN_SESSION_SECRET=
FINAN_MFA_EMAIL_ENABLED=true
FINAN_EMAIL_FROM=naoresponda@retiradas.tech
FINAN_SMTP_HOST=
FINAN_SMTP_PORT=587
FINAN_SMTP_SECURE=false
FINAN_SMTP_USER=
FINAN_SMTP_PASS=
