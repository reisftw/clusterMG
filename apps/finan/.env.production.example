# Template de producao do Finan. So placeholders — nunca preencha valores
# reais aqui e nunca commite o .env real (ja bloqueado por
# apps/finan/.gitignore e pelo .gitignore da raiz).
#
# Ver tabela completa de variaveis (obrigatoria/sensivel/default/impacto se
# ausente) no relatorio da fase de go-live.

# --- Rede / identidade publica ---
FINAN_API_PORT=3101
FINAN_PUBLIC_URL=https://finan.retiradas.tech
FINAN_CORS_ORIGINS=https://finan.retiradas.tech

# --- PostgreSQL ---
FINAN_DATABASE_URL=postgres://usuario:senha@host:5432/finan
FINAN_PGSSLMODE=
FINAN_PG_POOL_MAX=10
FINAN_PG_IDLE_TIMEOUT_MS=30000
FINAN_PG_CONNECTION_TIMEOUT_MS=5000
FINAN_SLOW_QUERY_MS=500

# --- Sessao / autenticacao ---
FINAN_SESSION_TTL_DAYS=7
FINAN_MFA_EMAIL_ENABLED=true
FINAN_MFA_EMAIL_TTL_MINUTES=10
FINAN_MFA_MAX_ATTEMPTS=5
FINAN_PASSWORD_RESET_TTL_MINUTES=30

# --- Rate limiting ---
FINAN_RATE_LIMIT_PER_MINUTE=600
FINAN_LOGIN_RATE_LIMIT=20
FINAN_MFA_RATE_LIMIT=30
FINAN_PASSWORD_RESET_RATE_LIMIT=10

# --- E-mail (SMTP) ---
FINAN_EMAIL_FROM=naoresponda@retiradas.tech
FINAN_EMAIL_FROM_NAME=
FINAN_EMAIL_REPLY_TO=
FINAN_SMTP_HOST=
FINAN_SMTP_PORT=587
FINAN_SMTP_SECURE=false
FINAN_SMTP_USER=
FINAN_SMTP_PASS=
FINAN_SMTP_CONNECTION_TIMEOUT_MS=
FINAN_SMTP_GREETING_TIMEOUT_MS=
FINAN_SMTP_SOCKET_TIMEOUT_MS=

# --- Backup ---
FINAN_BACKUP_DIR=/opt/retiradas/backups/finan
FINAN_BACKUP_MAX_BYTES=10737418240
FINAN_BACKUP_RETENTION=30

# --- Integracoes (opcional) ---
GOOGLE_APPLICATION_CREDENTIALS=
