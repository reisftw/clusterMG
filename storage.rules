rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /static/data.json {
      allow read:  if true;   // leitura pública
      allow write: if false;  // só a Cloud Function (firebase-admin) escreve
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}