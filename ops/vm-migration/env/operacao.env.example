NODE_ENV=production
ROT_API_PORT=3201
ROT_PUBLIC_URL=https://operacao.retiradas.tech
ROT_CORS_ORIGINS=https://operacao.retiradas.tech,https://rot.retiradas.tech

# Banco dedicado da Operacao. Use ROT_DATABASE_URL ou ROT_PG*.
ROT_DATABASE_URL=postgres://operacao_user:TROCAR@127.0.0.1:5432/operacao
ROT_PGHOST=127.0.0.1
ROT_PGPORT=5432
ROT_PGUSER=operacao_user
ROT_PGPASSWORD=TROCAR
ROT_PGDATABASE=operacao
ROT_PGSSLMODE=
ROT_PG_POOL_MAX=10
ROT_PG_IDLE_TIMEOUT_MS=30000
ROT_PG_CONNECTION_TIMEOUT_MS=5000
ROT_SLOW_QUERY_MS=500

# Auth/JWT.
ROT_JWT_SECRET=TROCAR
ROT_JWT_TTL=12h
ROT_JWT_ISSUER=operacao
ROT_JWT_AUDIENCE=operacao-web
ROT_PASSWORD_RESET_TTL_MINUTES=30
ROT_LOGIN_RATE_LIMIT=20
ROT_PASSWORD_RESET_RATE_LIMIT=10
ROT_RATE_LIMIT_PER_MINUTE=600

# Google OAuth.
ROT_GOOGLE_OAUTH_CLIENT_ID=
ROT_GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Email/MFA.
ROT_SMTP_HOST=smtp.hostinger.com
ROT_SMTP_PORT=465
ROT_SMTP_SECURE=true
ROT_SMTP_USER=
ROT_SMTP_PASSWORD=
ROT_EMAIL_FROM=naoresponda@retiradas.tech
ROT_EMAIL_FROM_NAME=OPERACAO | Cluster MG
ROT_EMAIL_REPLY_TO=
ROT_MFA_EMAIL_ENABLED=true
ROT_MFA_EMAIL_TTL_MINUTES=10
ROT_MFA_MAX_ATTEMPTS=5

# Integracao opcional para ler legado do Retiradas.
RETIRADAS_DATABASE_URL=
RETIRADAS_PGHOST=
RETIRADAS_PGPORT=5432
RETIRADAS_PGUSER=
RETIRADAS_PGPASSWORD=
RETIRADAS_PGDATABASE=
RETIRADAS_PGSSLMODE=

# Warlinho/Gemini.
ROT_GEMINI_API_KEY=
ROT_GEMINI_MODEL=

# Object storage de anexos, se usado.
STORAGE_DEFAULT_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=rot-site
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_FORCE_PATH_STYLE=false

