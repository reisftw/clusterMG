NODE_ENV=production
PORT=3001
PUBLIC_APP_URL=https://retiradas.tech
CORS_ORIGIN=https://retiradas.tech

# Banco Retiradas. Use DATABASE_URL ou o conjunto PG*.
DATABASE_URL=postgres://retiradas_user:TROCAR@127.0.0.1:5432/retiradas
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=retiradas_user
PGPASSWORD=TROCAR
PGDATABASE=retiradas
PGSSLMODE=

# Auth/JWT. Gerar com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_AUTH_SECRET=TROCAR
APP_AUTH_SECRET_ID=vm-empresa-2026-10
APP_AUTH_ISSUER=retiradas-api
APP_AUTH_AUDIENCE=retiradas-web
ACCESS_TOKEN_TTL_SECONDS=31536000
TOTP_ISSUER=Retiradas

# Email/MFA.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Retiradas
SMTP_FROM_EMAIL=naoresponda@retiradas.tech
SMTP_REPLY_TO=
MFA_EMAIL_ENABLED=true
MFA_EMAIL_TTL_MINUTES=10

# Google/OAuth/Drive, se usado.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=

# HubSoft/Playwright. Preferir configurar pelo painel quando possivel.
HUBSOFT_WEB_USERNAME=
HUBSOFT_WEB_PASSWORD=
PLAYWRIGHT_BROWSERS_PATH=/var/www/.cache/ms-playwright

# Uploads/cache.
UPLOADS_DIR=/opt/retiradas/vps/uploads
JSON_BODY_LIMIT=10mb
PUBLIC_STATIC_CACHE_TTL_MS=10000

